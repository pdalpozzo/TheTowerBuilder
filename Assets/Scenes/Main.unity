  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Please report bugs/feedback/suggestions to the following email: <color=#199EC9>
    thetowerbuilder@gmail.com </color>\nPreferred format is to place BUG, FEEDBACK
    or SUGGESTION into the subject title along with a breif description. \nExample:
    BUG Wrong damage numbers\n\nFeel free to comment about the code and design of
    the app. I am doing this to learn and any feedback will be helpful.\n\nAll of
    the data has been gather from the Wiki and Skye's Tools.\nWiki: <color=#199EC9>
    https://the-tower-idle-tower-defense.fandom.com/wiki/The_Tower_-_Idle_Tower_Defense_Wiki
    </color>\nSkye's Tools: <color=#199EC9> https://thetower.tools/ </color>\nSpecial
    thanks to <color=#DBB812> Shuckle </color> for the data provided about the upgrade
    formulas.\n\nThis app has been made in Unity and you can find the files at: <color=#199EC9>https://github.com/pdalpozzo/TheTowerBuilder
    </color>\nI give permission for others to copy the app and work on there own
    version.\n\nThis version is just to get the tool out there so people can start
    using it. Below is a rough roadmap for the tool. But keep in mind that I have
    a full time job and also studying so I might not have time to get to everything
    quickly.\n\n<color=#CF3F59> === v0.2 ===\r </color>\nFinish Calculation Panel
    - uptimes\r\nFinish All Stats - ultimate weapon damages, waves, enemy stats,
    perks\r\nSave and Export builds\r\n\r\n<color=#CF3F59> === v0.3 ===\r </color>\nAuto
    Update\r\n\r\n<color=#CF3F59> === v0.4 ===\r </color>\nTarget Priority page\r\nTournament
    option for tournament details\r\nCPH calculator\r\nEvent Mission Reference Page\r\n\r\n<color=#CF3F59>
    === v0.5 ===\r </color>\nVault\r\nBreakdown page showing details of each stat\r\nTier
    page showing max wave possible in relation to health and damage (projectile and
    all UWs)\r\n\r\n<color=#CF3F59> === other ideas ===\r </color>\nratios for UW
    sync\r\nBH area coverage - Bh range needed to reach 100% OR tower range needed
    to reach 100%\r\nBH/GT/CF uptime %\r\nbot uptime %\r\nbot area coverage\r\nDemon
    Mode uptime %\r\nRapid fire uptime %\r\nSuper Tower uptime %"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 98c7bf895ab21ac438c74c77ad4dba8c, type: 2}
